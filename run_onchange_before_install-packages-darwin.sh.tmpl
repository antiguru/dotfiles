# Rust via rustup, installed only when absent: rustup then updates itself and
# the toolchains, so the pin only fixes the version a fresh machine starts from.
# Not Homebrew's rust formula: it links cargo/rustc into the brew prefix, which
# shadows ~/.cargo/bin and gets relinked on every upgrade. Mirrors the Linux
# install-local-bin script; see there for the checksum and component rationale.
# renovate: datasource=github-tags depName=rust-lang/rustup
rustup_version="1.29.1"
if [ ! -x "$HOME/.cargo/bin/rustup" ]; then
  case "$(uname -m)" in
    arm64)  rustup_arch=aarch64 ;;
    x86_64) rustup_arch=x86_64 ;;
    *) echo "unsupported arch: $(uname -m)" >&2; exit 1 ;;
  esac
  tmp=$(mktemp -d)
  url="https://static.rust-lang.org/rustup/archive/${rustup_version}/${rustup_arch}-apple-darwin/rustup-init"
  curl -fsSL "$url" -o "$tmp/rustup-init"
  echo "$(curl -fsSL "$url.sha256" | cut -d' ' -f1)  $tmp/rustup-init" | shasum -a 256 -c --quiet - \
    || { echo "rustup-init checksum mismatch" >&2; exit 1; }
  chmod +x "$tmp/rustup-init"
  "$tmp/rustup-init" -y --no-modify-path --default-toolchain stable \
    --component rust-src,llvm-tools
  rm -rf "$tmp"
fi

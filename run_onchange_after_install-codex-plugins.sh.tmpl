#!/usr/bin/env bash
# Mirror the Claude Code plugin and MCP setup into Codex (~/.codex/config.toml).
# Re-runs whenever this file changes. Every command is idempotent: marketplace
# and plugin adds skip what is present, and `codex mcp add` overwrites a server
# of the same name.
set -euo pipefail

command -v codex >/dev/null || { echo "codex CLI not on PATH; skipping"; exit 0; }

config="${CODEX_HOME:-$HOME/.codex}/config.toml"
mkdir -p "$(dirname "$config")"
touch "$config"

# Read CLAUDE.md in repos without an AGENTS.md. Codex rewrites config.toml, so
# it is not a chezmoi-managed file. Top-level keys must precede every table,
# hence prepend instead of append.
if ! grep -q '^project_doc_fallback_filenames' "$config"; then
  { echo 'project_doc_fallback_filenames = ["CLAUDE.md"]'; cat "$config"; } >"$config.new"
  mv "$config.new" "$config"
fi

# Plugins. superpowers ships a native Codex manifest in its own repo, so use
# that marketplace instead of claude-plugins-official. pr-review-toolkit is not
# mirrored: it only contains Claude agents and commands, which Codex ignores.
codex plugin marketplace add obra/superpowers
codex plugin add superpowers@superpowers-dev
codex plugin marketplace add JuliusBrussee/caveman
codex plugin add caveman@caveman

# MCP servers, same set as run_onchange_after_install-claude-mcp.sh.tmpl.
codex mcp add github -- \
  sh -c 'GITHUB_PERSONAL_ACCESS_TOKEN=$(gh auth token) exec github-mcp-server stdio'
codex mcp add pollard -- pollard
codex mcp add playwright -- npx @playwright/mcp@latest

# HTTP MCP servers. `codex mcp add --url` starts an interactive OAuth flow and
# blocks apply until it times out, so append the entry ourselves when absent.
# Leaving existing entries alone also keeps their stored OAuth tokens. Log in
# once per server with `codex mcp login NAME`.
add_http() {
  codex mcp get "$1" >/dev/null 2>&1 && return
  printf '\n[mcp_servers.%s]\nurl = "%s"\n' "$1" "$2" >>"$config"
}
add_http polarsignals https://api.polarsignals.com/api/mcp
add_http rustrover http://localhost:64342/stream
add_http launchdarkly https://mcp.launchdarkly.com/mcp/launchdarkly
add_http buildkite https://mcp.buildkite.com/mcp
add_http context-graph https://context-graph-prod.corvus-bluegill.ts.net/api/mcp/agent

# Grafana runs in Docker; the token lands in ~/.codex/config.toml, as it does
# in ~/.claude.json for Claude.
codex mcp add grafana \
  --env GRAFANA_URL=https://grafana.dev.materialize.com/ \
  --env GRAFANA_SERVICE_ACCOUNT_TOKEN={{ include "grafana_token.age" | decrypt | trim | quote }} \
  -- docker run --rm -i -e GRAFANA_URL -e GRAFANA_SERVICE_ACCOUNT_TOKEN grafana/mcp-grafana -t stdio

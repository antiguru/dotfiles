{
  "permissions": {
    "allow": [
      "Bash(bk artifacts download:*)",
      "Bash(bk artifacts list:*)",
      "Bash(bk build list:*)",
      "Bash(bk build view:*)",
      "Bash(bk build watch:*)",
      "Bash(bk job list:*)",
      "Bash(bk job log:*)",
      "Bash(cargo +nightly fmt:*)",
      "Bash(cargo bench:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo deny:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo hakari:*)",
      "Bash(cargo insta accept:*)",
      "Bash(cargo run:*)",
      "Bash(cargo rustc:*)",
      "Bash(cargo test:*)",
      "Bash(find:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(git add:*)",
      "Bash(git api:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git pr list:*)",
      "Bash(git pr view:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git status:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(psql:*)",
      "Read(~/.cargo/registry/index/*)",
      "Read(~/.cargo/registry/src)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:registry.npmjs.org)",
      "mcp__github",
      "mcp__lumen",
      "mcp__plugin_binutils-mcp_binutils-mcp",
      "mcp__plugin_github_github",
      "mcp__plugin_lumen_lumen",
      "mcp__plugin_pollard_pollard",
      "mcp__polarsignals",
      "mcp__pollard",
      "mcp__buildkite"
    ]
  },
  "model": "claude-opus-4-8",
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/worktree-create.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/usr/bin/python3 {{ .chezmoi.homeDir }}/.claude/statusline.py WORK"
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "linear@claude-plugins-official": false,
    "lumen@ory": false,
    "caveman@caveman": true,
    "plugin-dev@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": true,
    "binutils-mcp@antiguru-tools": true,
    "pollard@antiguru-tools": true
  },
  "extraKnownMarketplaces": {
    "ory": {
      "source": {
        "source": "github",
        "repo": "ory/claude-plugins"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "antiguru-tools": {
      "source": {
        "source": "github",
        "repo": "antiguru/antiguru-tools"
      }
    }
  },
  "tui": "fullscreen",
  "editorMode": "vim",
  "agentPushNotifEnabled": true,
  "skipDangerousModePermissionPrompt": true
}

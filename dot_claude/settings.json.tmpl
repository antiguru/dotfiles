{
  "permissions": {
    "allow": [
      "Bash(bk artifacts download *)",
      "Bash(bk artifacts list *)",
      "Bash(bk build list *)",
      "Bash(bk build view *)",
      "Bash(bk build watch *)",
      "Bash(bk job list *)",
      "Bash(bk job log *)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo deny *)",
      "Bash(cargo fmt *)",
      "Bash(cargo hakari *)",
      "Bash(cargo test *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr view *)",
      "Bash(git api *)",
      "Bash(git diff *)",
      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git pr list *)",
      "Bash(git pr view *)",
      "Bash(git status *)",
      "Read(~/.cargo/registry/index/*)",
      "mcp__lumen",
      "mcp__pollard",
      "mcp__polarsignals"
    ]
  },
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '[.worktree_path, .main_repo_path] | @tsv' | { IFS=$'\\t' read -r wt main; mkdir -p \"$wt/.claude\" && jq -n --arg dir \"$main\" '{permissions:{additionalDirectories:[$dir]}}' > \"$wt/.claude/settings.local.json\" && printf '%s\\n' \"$wt\"; }"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash {{ .chezmoi.homeDir }}/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "github@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "linear@claude-plugins-official": false,
    "timely-skill@timely-dataflow-skill": true,
    "columnar-skill@timely-dataflow-skill": true,
    "lumen@ory": true,
    "superpowers@claude-plugins-official": true,
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "timely-dataflow-skill": {
      "source": {
        "source": "github",
        "repo": "antiguru/timely-skill"
      },
      "autoUpdate": true
    },
    "ory": {
      "source": {
        "source": "github",
        "repo": "ory/claude-plugins"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "tui": "fullscreen",
  "editorMode": "vim",
  "agentPushNotifEnabled": true
}

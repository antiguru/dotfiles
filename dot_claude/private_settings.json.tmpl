{
  "env": {
    "CI_DASHBOARD_TOKEN": "{{ include "ci_dev_token.age" | decrypt | trim }}"{{ if eq .chezmoi.os "linux" }},
    "CLAUDE_CODE_SHELL_PREFIX": "{{ .chezmoi.homeDir }}/.local/bin/claude-shell-prefix"{{ end }}
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(bk artifacts download:*)",
      "Bash(bk artifacts list:*)",
      "Bash(bk build list:*)",
      "Bash(bk build view:*)",
      "Bash(bk build watch:*)",
      "Bash(bk job list:*)",
      "Bash(bk job log:*)",
      "Bash(cargo +nightly fmt:*)",
      "Bash(cargo bench:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo deny:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo hakari:*)",
      "Bash(cargo insta accept:*)",
      "Bash(cargo run:*)",
      "Bash(cargo rustc:*)",
      "Bash(cargo test:*)",
      "Bash(find:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(git add:*)",
      "Bash(git api:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git pr list:*)",
      "Bash(git pr view:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git status:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(psql:*)",
      "Read(~/.cargo/registry/index/*)",
      "Read(~/.cargo/registry/src)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:registry.npmjs.org)",
      "mcp__github",
      "mcp__lumen",
      "mcp__plugin_binutils-mcp_binutils-mcp",
      "mcp__plugin_github_github",
      "mcp__plugin_lumen_lumen",
      "mcp__plugin_pollard_pollard",
      "mcp__polarsignals",
      "mcp__pollard",
      "mcp__buildkite"
    ]
  },
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/worktree-create.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/mzcompose-reaper.sh pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/mzcompose-reaper.sh post"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/mzcompose-reaper.sh start"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/mzcompose-reaper.sh end"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/usr/bin/python3 {{ .chezmoi.homeDir }}/.claude/statusline.py WORK"
  },
  "skillOverrides": {
    "gh": "off"
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": false,
    "clangd-lsp@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "github@claude-plugins-official": false,
    "linear@claude-plugins-official": false,
    "lumen@ory": false,
    "caveman@caveman": true,
    "plugin-dev@claude-plugins-official": false,
    "mcp-server-dev@claude-plugins-official": false,
    "buildkite@claude-plugins-official": false,
    "playwright@claude-plugins-official": false,
    "cc-plugin-you-should-know@builtin": true
  },
  "extraKnownMarketplaces": {
    "ory": {
      "source": {
        "source": "github",
        "repo": "ory/claude-plugins"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "editorMode": "vim",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "environment": [
      "$defaults",
      "**Organization**: Materialize, GitHub org MaterializeInc. The user is an engineer on the open-source database in MaterializeInc/materialize.",
      "**Trusted repo**: ~/dev/repos/materialize and its worktrees under .claude/worktrees/. Remote `origin` is the user's fork and `upstream` is MaterializeInc/materialize, the user pushes to both. Any other remote is a colleague's fork and is fetch-only.",
      "**Host**: sessions usually run inside claude-jail, a sandbox on the user's workstation. Some run outside it with the user's full permissions.",
      "**Dotfiles**: ~/.claude is generated from the chezmoi source at ~/.local/share/chezmoi, which is a public GitHub repo. Workspace identifiers and secrets must not be written there.",
      "**Sensitive remote targets**: any host, namespace or environment with `prod` or `production` as a whole word."
    ],
    "allow": [
      "$defaults",
      "Running the trusted repo's tooling: bin/mzcompose (its `down` deletes that composition's volumes), bin/fmt, bin/lint, bin/sqllogictest, cargo check/build/test.",
      "Pushing the user's own feature branches to `origin` or `upstream`, including with --force-with-lease, and gh stack commands with --remote upstream. Native GitHub stacks require their branches on upstream.",
      "Running `docker compose -p <project> down` for compositions this session started or whose working directory no longer exists."
    ],
    "soft_deny": [
      "$defaults",
      "Pushing to upstream's main, or deleting any upstream branch the user did not create.",
      "Any manual release step: creating or pushing release branches or tags, or running release tooling by hand. Releases go through automation only.",
      "Pushing to a branch the user did not create, such as a colleague's branch on upstream or on another remote.",
      "Force-pushing a branch that is the base of another open PR without first repointing the dependents. GitHub then marks the dependent PRs merged and deletes their branches.",
      "`git push --force` without --force-with-lease.",
      "Running ci/test/console/e2e-prod.sh or any command against a prod or production environment."
    ]
  }
}

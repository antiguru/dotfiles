  zip="awscli-exe-linux-$(uname -m)-${awscli_version}.zip"
  curl -fsSL "https://awscli.amazonaws.com/$zip" -o "$tmp/$zip"
  curl -fsSL "https://awscli.amazonaws.com/$zip.sig" -o "$tmp/$zip.sig"
  gpgv --keyring "$tmp/key.gpg" "$tmp/$zip.sig" "$tmp/$zip"
  unzip -q "$tmp/$zip" -d "$tmp"

{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# Install tools into the per-user ~/.local/bin on Linux (no sudo), where they
# have no distro package and Homebrew is intentionally absent. System packages
# live in bootstrap/debian.sh instead. Re-runs whenever this file changes (e.g.
# a version bump below); each tool is skipped when already at the pinned version.
set -euo pipefail

bin="$HOME/.local/bin"
mkdir -p "$bin"

# uname -m mapped to each project's release-asset arch naming.
case "$(uname -m)" in
  x86_64)  buf_arch=x86_64;  helm_arch=x86_64; th_arch=amd64; uv_arch=x86_64 ;;
  aarch64) buf_arch=aarch64; helm_arch=arm64;  th_arch=arm64; uv_arch=aarch64 ;;
  *) echo "unsupported arch: $(uname -m)" >&2; exit 1 ;;
esac

# at_version BIN VERSION: true when BIN exists and reports VERSION.
at_version() { [ -x "$1" ] && "$1" --version 2>&1 | grep -qF "$2"; }

# install_tar URL BIN...: extract the named binaries from a release tarball.
install_tar() {
  local url=$1; shift
  local tmp; tmp=$(mktemp -d)
  curl -fsSL "$url" -o "$tmp/dl.tar.gz"
  tar -xzf "$tmp/dl.tar.gz" -C "$tmp"
  local b
  for b in "$@"; do
    install -m755 "$(find "$tmp" -type f -name "$b" -print -quit)" "$bin/$b"
  done
  rm -rf "$tmp"
}

# buf: single binary, asset named buf-Linux-<arch>.
# renovate: datasource=github-releases depName=bufbuild/buf
buf_version="1.73.0"
if ! at_version "$bin/buf" "$buf_version"; then
  curl -fsSL \
    "https://github.com/bufbuild/buf/releases/download/v${buf_version}/buf-Linux-${buf_arch}" \
    -o "$bin/buf"
  chmod +x "$bin/buf"
fi

# helm-docs
# renovate: datasource=github-releases depName=norwoodj/helm-docs
helm_docs_version="1.14.2"
at_version "$bin/helm-docs" "$helm_docs_version" || install_tar \
  "https://github.com/norwoodj/helm-docs/releases/download/v${helm_docs_version}/helm-docs_${helm_docs_version}_Linux_${helm_arch}.tar.gz" \
  helm-docs

# trufflehog
# renovate: datasource=github-releases depName=trufflesecurity/trufflehog
trufflehog_version="3.97.9"
at_version "$bin/trufflehog" "$trufflehog_version" || install_tar \
  "https://github.com/trufflesecurity/trufflehog/releases/download/v${trufflehog_version}/trufflehog_${trufflehog_version}_linux_${th_arch}.tar.gz" \
  trufflehog

# uv ships uv + uvx; the release tag has no leading v.
# renovate: datasource=github-releases depName=astral-sh/uv
uv_version="0.12.19"
at_version "$bin/uv" "$uv_version" || install_tar \
  "https://github.com/astral-sh/uv/releases/download/${uv_version}/uv-${uv_arch}-unknown-linux-gnu.tar.gz" \
  uv uvx

# github-mcp-server: backs the github MCP server (brew-only on macOS). Shares
# helm-docs' Linux_<arch> asset naming.
# renovate: datasource=github-releases depName=github/github-mcp-server
github_mcp_version="1.12.2"
at_version "$bin/github-mcp-server" "$github_mcp_version" || install_tar \
  "https://github.com/github/github-mcp-server/releases/download/v${github_mcp_version}/github-mcp-server_Linux_${helm_arch}.tar.gz" \
  github-mcp-server


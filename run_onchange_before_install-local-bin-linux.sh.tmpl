# against the AWS CLI Team key (fingerprint FB5D B77F D5C1 18B8 0511 ADA8 A631
# 0ACC 4672 475C, expires 2027-07-01). The installer puts the bundled runtime in
# ~/.local/share/aws-cli and symlinks aws and aws_completer into ~/.local/bin.
# Its asset arch naming matches uname -m.
# renovate: datasource=github-tags depName=aws/aws-cli
awscli_version="2.37.9"

{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# claude-jail: run Claude Code inside a bwrap jail.
#
# Visible/writable: cwd + ~/dev/repos, Claude config dir, ~/.cargo,
# Docker socket, ssh agent + creds (ro), network, one own cgroup (for memcap).
# Everything else in $HOME hidden behind tmpfs.
#
# Leading --netns runs the jail in its own network namespace (via pasta) so a
# server started inside (e.g. a Materialize environmentd) does not collide on
# ports with the host or other jails, while host services stay reachable at
# their usual localhost:port. Requires the passt package.
#
# Honors CLAUDE_CONFIG_DIR (e.g. claude-personal alias).
# Design: ~/.claude/plans/claude-jail.md
set -euo pipefail

config_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
cwd="$(pwd)"
uid="$(id -u)"

# bwrap maps only the current gid into the user namespace. Re-exec with the
# docker group as primary gid so docker.sock stats as its real gid inside the
# jail instead of overflow 65534 (nobody) — bin/ci-builder passes that gid to
# `docker run --user`, and 65534 collides with the image's nogroup.
# Trade-off: files created inside the jail get group docker on the host.
docker_gid="$(stat -c %g /var/run/docker.sock 2>/dev/null || true)"
if [[ -n "$docker_gid" && "$(id -g)" != "$docker_gid" ]] \
    && id -G | tr ' ' '\n' | grep -qx "$docker_gid"; then
  exec sg docker -c "$(printf '%q ' "$0" "$@")"
fi

# Per-jail cgroup, so ~/.local/bin/memcap can run a command under a memory cap.
# systemd delegates user@$uid.service to us, so a child cgroup there takes
# memory.max without root and without systemd-run's D-Bus round trip: the jail
# has no bus socket, and binding one in would let jailed code start processes on
# the host. Only this one directory is bound into the jail, so memcap can shape
# the jail's own processes and nothing else of the user's.
cgroup_root="/sys/fs/cgroup/user.slice/user-$uid.slice/user@$uid.service"
jail_cgroup=""
if [[ -w "$cgroup_root/cgroup.subtree_control" ]]; then
  # Nothing else reaps these, so drop the ones left by jails that have exited.
  # Emptiness is not the test: a live jail's own processes stay in the cgroup
  # they were started from, so its cgroup here sits empty between memcap runs.
  # The suffix is the pid of this script, which `exec bwrap` below keeps, so a
  # live pid means a live jail.
  for stale in "$cgroup_root"/claude-jail-*; do
    [[ -d "$stale" ]] || continue
    [[ -d "/proc/${stale##*-}" ]] && continue
    find "$stale" -depth -type d -exec rmdir {} + 2>/dev/null
  done
  # No .scope/.service suffix: systemd reaps cgroups that look like its units.
  jail_cgroup="$cgroup_root/claude-jail-$$"
  # memcap sets memory.max on a child, which only works if we hand the
  # controller down. Enabling it also forbids processes in this cgroup itself,
  # which suits us: the jail stays where it is and only memcap's children move.
  if ! (mkdir -p "$jail_cgroup" && echo +memory > "$jail_cgroup/cgroup.subtree_control") 2>/dev/null; then
    rmdir "$jail_cgroup" 2>/dev/null || true
    jail_cgroup=""
  fi
fi

# Opt-in: --netns runs the jail in its own network namespace so bound ports
# (e.g. a Materialize environmentd) don't collide with other jails or the host.
# pasta gives that namespace userspace NAT for egress, plus -T to reach a host
# service on the same port inside the ns (Cockroach on 26257).
netns=0
if [[ "${1:-}" == "--netns" ]]; then
  netns=1
  shift
fi

args=(
  # System, read-only (merged-usr layout).
  --ro-bind /usr /usr
  --symlink usr/bin /bin
  --symlink usr/lib /lib
  --symlink usr/lib64 /lib64
  --symlink usr/sbin /sbin
  --ro-bind /etc /etc
  # Userns maps root-owned files to nobody; ssh rejects includes with
  # "Bad owner" — mask the include dir.
  --tmpfs /etc/ssh/ssh_config.d
  --proc /proc
  --dev /dev
  # KVM for nested VMs. --dev tmpfs has no kvm node, so bind the host one back
  # on top of it. Binding only makes the node visible: the userns maps a single
  # gid, so the kvm group (991) is unmapped and the group bits can never match.
  # /dev/kvm must be world-accessible on the host (udev MODE="0666").
  --dev-bind-try /dev/kvm /dev/kvm
  # Hide /run and /var; recreate the /var/run -> /run symlink.
  --tmpfs /run
  --tmpfs /var
  --symlink ../run /var/run
  --perms 0700 --dir "/run/user/$uid"
  # Docker daemon resolves -v paths on the HOST, so /tmp and repo paths
  # must be identical inside and outside the jail.
  --bind /tmp /tmp
  --bind /var/run/docker.sock /run/docker.sock
  # Hide $HOME, then bind back only what is needed.
  --tmpfs "$HOME"
  --bind "$HOME/dev/repos" "$HOME/dev/repos"
  --bind "$config_dir" "$config_dir"
  --bind-try "$HOME/.claude.json" "$HOME/.claude.json"
  # statusLine and the WorktreeCreate hook run scripts under ~/.claude
  # regardless of config_dir, so the personal jail (config_dir =
  # ~/.claude-personal) needs them bound too.
  --ro-bind-try "$HOME/.claude/statusline.py" "$HOME/.claude/statusline.py"
  --ro-bind-try "$HOME/.claude/hooks" "$HOME/.claude/hooks"
  --bind-try "$HOME/.claude.json.backup" "$HOME/.claude.json.backup"
  --bind "$HOME/.cargo" "$HOME/.cargo"
  --ro-bind "$HOME/.rustup" "$HOME/.rustup"
  # Claude launcher + versions; rw so auto-update works.
  --bind "$HOME/.local/bin" "$HOME/.local/bin"
  --bind "$HOME/.local/share/claude" "$HOME/.local/share/claude"
  # /opt: teleport (tsh) and other system-installed tools, read-only.
  --ro-bind-try /opt /opt
  # Credentials for git push / gh, read-only.
  --ro-bind-try "$HOME/.ssh" "$HOME/.ssh"
  # Materialize license key file ($MZ_LICENSE_KEY points here).
  --ro-bind-try "${MZ_LICENSE_KEY:-$HOME/.mz-license-key}" "${MZ_LICENSE_KEY:-$HOME/.mz-license-key}"
  --ro-bind-try "$HOME/.config/materialize" "$HOME/.config/materialize"
  --ro-bind-try "$HOME/.gitconfig" "$HOME/.gitconfig"
  --ro-bind-try "$HOME/.config/gh" "$HOME/.config/gh"
  --ro-bind-try "$HOME/.config/git" "$HOME/.config/git"
  # Shell init, read-only.
  --ro-bind-try "$HOME/.zshrc" "$HOME/.zshrc"
  --ro-bind-try "$HOME/.zshenv" "$HOME/.zshenv"
  --ro-bind-try "$HOME/.oh-my-zsh" "$HOME/.oh-my-zsh"
)

if [[ -n "$jail_cgroup" ]]; then
  args+=(
    --bind "$jail_cgroup" "$jail_cgroup"
    --setenv CLAUDE_JAIL_CGROUP "$jail_cgroup"
  )
fi

# ssh agent socket.
if [[ -n "${SSH_AUTH_SOCK:-}" && -S "$SSH_AUTH_SOCK" ]]; then
  args+=(--bind "$SSH_AUTH_SOCK" "$SSH_AUTH_SOCK")
fi

# cwd outside ~/dev/repos: bind it at the same path.
case "$cwd" in
  "$HOME/dev/repos" | "$HOME/dev/repos"/*) ;;
  *) args+=(--bind "$cwd" "$cwd") ;;
esac

args+=(
  --chdir "$cwd"
  # --unshare-all minus the cgroup namespace, which has to stay shared: cgroup2
  # is mounted with nsdelegate, so a process in its own cgroup namespace cannot
  # be moved into a cgroup outside that namespace's root, and CLAUDE_JAIL_CGROUP
  # sits outside it. Unsharing it makes memcap's write to cgroup.procs fail with
  # ENOENT. Sharing costs the jail's own cgroup path in /proc/self/cgroup; other
  # processes' paths stay hidden behind --unshare-pid.
  --unshare-user-try
  --unshare-ipc
  --unshare-pid
  --unshare-uts
  # Keep --share-net even with --netns: pasta spawns us inside its own network
  # namespace, and --share-net makes bwrap inherit that ns instead of creating
  # a fresh empty one. Without --netns this is the host network namespace.
  --share-net
  --die-with-parent
)

# --netns: wrap the whole thing in pasta.
#   --config-net     copy host addressing/routes into the ns; NAT egress out.
#   -t none -u none  disable inbound host->ns port forwarding, so the jail binds
#                    its own ports freely. Two jails (or a jail and the host) can
#                    each bind e.g. environmentd's 6875 with no collision.
# pasta's default outbound splice (-T auto) still forwards ns->host for ports the
# jail is not itself binding, so a jailed environmentd reaches the host Cockroach
# at the usual localhost:26257 with no Materialize config change.
launcher=()
if [[ "$netns" -eq 1 ]]; then
  launcher=(pasta --config-net -t none -u none --)
  # pasta's userns maps us to uid 0. bwrap's nested userns remaps that single
  # uid back to the real one, so claude does not refuse
  # --dangerously-skip-permissions as root.
  args+=(--uid "$uid" --gid "$(id -g)")
fi

# Jail is the permission boundary; skip per-tool prompts inside.
# Known holes (accepted): docker.sock = host root; creds + network live inside.
#
# The `remote-control`/`rc` subcommand hides its real options (--spawn,
# --capacity, ...) whenever --dangerously-skip-permissions is set, collapsing
# to a help-only parser. For that subcommand drop the global flag and set the
# spawned-session permission mode instead, unless the caller already passed one.
case "${1:-}" in
  remote-control | rc)
    has_perm_mode=0
    for arg in "$@"; do
      case "$arg" in
        --permission-mode | --permission-mode=*) has_perm_mode=1 ;;
      esac
    done
    rc_args=("$@")
    if [[ "$has_perm_mode" -eq 0 ]]; then
      rc_args+=(--permission-mode bypassPermissions)
    fi
    exec "${launcher[@]}" bwrap "${args[@]}" -- claude "${rc_args[@]}"
    ;;
esac

exec "${launcher[@]}" bwrap "${args[@]}" -- claude --dangerously-skip-permissions "$@"
{{- else if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# claude-jail (macOS): run Claude Code inside a sandbox-exec (Seatbelt) jail.
#
# Read+write: cwd, ~/dev/repos, Claude config dir, ~/.cargo, temp.
# Readable:   everything outside $HOME (system dirs etc.); inside $HOME only
#             ~/.rustup, shell init, git/gh config, ~/.ssh/known_hosts + config.
# Denied:     all other $HOME reads (~/.ssh keys, ~/Documents, ~/Library, ...)
#             and all writes outside the read+write set.
# Network:    unrestricted outbound. Docker: opt-in via leading --docker.
#
# Honors CLAUDE_CONFIG_DIR (e.g. claude-personal alias).
# Design: docs/superpowers/specs/2026-06-04-claude-jail-macos-design.md
#
# Accepted holes: world-readable system files stay readable (not a syscall jail);
# no egress filtering; --docker = full host compromise (orbstack root + -v /:/host).
#
# Uses sandbox-exec(1)/Seatbelt — Apple-deprecated but present through macOS 26.
# If a future release removes it, the exec below fails; replace with another jail.
set -euo pipefail

config_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
cwd="$(pwd)"

# Opt-in docker: must be the first argument.
docker=0
if [[ "${1:-}" == "--docker" ]]; then
  docker=1
  shift
fi

# A double-quote, backslash, or newline in a path interpolated into the SBPL
# profile below would break the string literal or inject rules. config_dir comes
# from CLAUDE_CONFIG_DIR (user-controlled), so guard it too; $HOME is set by the
# trusted login session.
for _p in "$cwd" "$config_dir"; do
  case "$_p" in
    *'"'* | *'\'*) echo "claude-jail: refusing path with quote or backslash: $_p" >&2; exit 1 ;;
  esac
  if [[ "$_p" == *$'\n'* ]]; then
    echo "claude-jail: refusing path with newline: $_p" >&2
    exit 1
  fi
done

# OrbStack docker socket, real path (Seatbelt resolves symlinks).
# OrbStack-specific; Docker Desktop would instead be ~/.docker/run/docker.sock.
docker_sock="$HOME/.orbstack/run/docker.sock"

profile="(version 1)
(deny default)

;; syscalls/services needed to run node + tools (not the security boundary)
(allow process-fork process-exec*)
;; signal unrestricted: unlike the linux branch (bwrap PID namespace) macOS has no
;; PID isolation, so this also permits signaling other same-user processes — an
;; accepted annoyance, not a host-compromise vector. (target self) breaks subprocesses.
(allow signal)
(allow sysctl-read)
(allow mach-lookup)
;; POSIX named semaphores: Python multiprocessing (spawn, the macOS default) calls
;; sem_open for its pool locks, so tools like materialize's bin/lint abort with
;; EPERM without this. An IPC primitive, not a host-data vector.
(allow ipc-posix-sem)
;; samply (cargo profiler) registers an ipc-channel bootstrap name to siphon the
;; sampled task port. Scoped to that prefix; publishing a name grants no host data.
(allow mach-register (global-name-regex #\"^org\\.rust-lang\\.ipc-channel\"))
(allow file-read-metadata)
(allow network*)

;; reads: broad. dyld + frameworks touch many system paths and enumerating them
;; is fragile, so allow read everywhere, then deny \$HOME below. The security
;; boundary is \$HOME — re-allowed only for the workspace + explicit allowlist.
(allow file-read*)
(deny file-read* (subpath \"$HOME\"))

;; writable system locations (temp, devices)
(allow file-read* file-write* (subpath \"/dev\"))
(allow file-ioctl (subpath \"/dev\"))   ;; tty raw mode (setRawMode/tcsetattr); TUIs need it
(allow file-read* file-write* (subpath \"/private/tmp\")
                              (subpath \"/private/var/folders\"))

;; workspace + state (rw)
(allow file-read* file-write* (subpath \"$cwd\"))
(allow file-read* file-write* (subpath \"$HOME/dev/repos\"))
(allow file-read* file-write* (subpath \"$config_dir\"))
(allow file-read* file-write* (literal \"$HOME/.claude.json\")
                              (literal \"$HOME/.claude.json.backup\"))
;; projects/ in each config_dir is a symlink to this neutral store shared by
;; both profiles; the resolved target is outside config_dir, so allow it rw.
(allow file-read* file-write* (subpath \"$HOME/.local/share/claude\"))
(allow file-read* file-write* (subpath \"$HOME/.cargo\"))
;; uv keeps its package cache here (XDG default on macOS too, not ~/Library/Caches);
;; rw or every uv/uvx invocation fails to read and rewrite the cache.
(allow file-read* file-write* (subpath \"$HOME/.cache/uv\"))

;; statusLine and the WorktreeCreate hook run scripts under ~/.claude regardless
;; of config_dir, so the personal jail (config_dir = ~/.claude-personal) needs
;; read on them too.
(allow file-read* (literal \"$HOME/.claude/statusline.py\")
                  (subpath \"$HOME/.claude/hooks\"))

;; read-only: toolchain, shell init, git/gh config, materialize config
(allow file-read* (subpath \"$HOME/.rustup\")
                  (literal \"$HOME/.zshrc\") (literal \"$HOME/.zshenv\")
                  (subpath \"$HOME/.oh-my-zsh\")
                  (literal \"$HOME/.gitconfig\") (literal \"$HOME/.gitignore\")
                  (subpath \"$HOME/.config/git\")
                  (subpath \"$HOME/.config/gh\")
                  (subpath \"$HOME/.config/materialize\"))

;; ssh: agent only; known_hosts + config ro; private keys not allowed.
;; ~/.ssh/config unconditionally Includes ~/.orbstack/ssh/config; an unreadable
;; Include is fatal to ssh, so allow that config file (not the orbstack keys,
;; which stay behind the \$HOME deny unless --docker).
(allow file-read* (literal \"$HOME/.ssh/known_hosts\") (literal \"$HOME/.ssh/config\")
                  (literal \"$HOME/.orbstack/ssh/config\"))
"
# --docker lifts both OrbStack capabilities (same blast radius — `ssh orb` reaches
# the VM, which bind-mounts the mac home). Default: socket connect denied and the
# orbstack ssh keys stay behind the $HOME deny. Appended after (allow network*) /
# (deny file-read* $HOME) so last-match-wins applies.
if [[ "$docker" -eq 0 ]]; then
  profile+="
;; docker: orbstack socket connect denied (lift with --docker)
(deny network-outbound (literal \"$docker_sock\"))
"
else
  profile+="
;; --docker: ssh orb needs the orbstack config + VM key + known_hosts, which
;; ~/.ssh/config pulls in via Include. ro; reachable only because --docker is set.
(allow file-read* (subpath \"$HOME/.orbstack/ssh\"))
"
fi

# The github MCP server runs `gh auth token`. Inside the jail that can only read
# the token from ~/.config/gh/hosts.yml (ro-allowed); the macOS keychain, where
# gh stores it by default, is behind the $HOME deny. Warn (do not block) when the
# token is keychain-only, and print the one-shot fix, so github tooling does not
# fail silently mid-session.
gh_hosts="$HOME/.config/gh/hosts.yml"
if ! grep -q "oauth_token:" "$gh_hosts" 2>/dev/null; then
  echo "claude-jail: gh token not in $gh_hosts (keychain-only); gh and the github MCP will fail inside the jail." >&2
  echo "claude-jail: move it to a jail-readable file with:" >&2
  echo "  gh auth token | gh auth login --hostname github.com --git-protocol ssh --with-token --insecure-storage" >&2
fi

# The `remote-control`/`rc` subcommand hides its real options (--spawn,
# --capacity, ...) whenever --dangerously-skip-permissions is set, collapsing
# to a help-only parser. For that subcommand drop the global flag and set the
# spawned-session permission mode instead, unless the caller already passed one.
case "${1:-}" in
  remote-control | rc)
    has_perm_mode=0
    for arg in "$@"; do
      case "$arg" in
        --permission-mode | --permission-mode=*) has_perm_mode=1 ;;
      esac
    done
    rc_args=("$@")
    if [[ "$has_perm_mode" -eq 0 ]]; then
      rc_args+=(--permission-mode bypassPermissions)
    fi
    exec sandbox-exec -p "$profile" claude "${rc_args[@]}"
    ;;
esac

exec sandbox-exec -p "$profile" claude --dangerously-skip-permissions "$@"
{{- else -}}
#!/usr/bin/env bash
echo "claude-jail: unsupported OS" >&2
exit 1
{{- end }}
